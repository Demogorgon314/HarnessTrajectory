{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Trajectory",
  "version": "0.4.0",
  "identifier": "com.harnesstrajectory.desktop",
  "build": {
    "frontendDist": "bootstrap",
    "beforeDevCommand": "pnpm desktop:prepare",
    "beforeBuildCommand": "pnpm desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Explore local coding-agent sessions",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/generated/Assets.car"],
    "externalBin": ["binaries/trajectory-node"],
    "resources": { "resources/": "resources/" },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "entitlements": "Entitlements.plist"
    }
  }
}
