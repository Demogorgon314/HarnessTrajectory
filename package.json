{
  "name": "harness-trajectory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build && node scripts/bundle-web.mjs",
    "start": "node apps/server/dist/main.js",
    "pack:cli": "pnpm build && pnpm --filter @demogorgon314/harness-trajectory pack",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:prepare": "node scripts/desktop/prepare.mjs",
    "desktop:smoke": "node scripts/desktop/smoke.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
