{
  "name": "@demogorgon314/harness-trajectory",
  "version": "0.2.1",
  "description": "Local viewer for Claude Code, Codex, Kimi Code and Grok Build session transcripts",
  "type": "module",
  "license": "MIT",
  "bin": {
    "harness-trajectory": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demogorgon314/HarnessTrajectory.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/Demogorgon314/HarnessTrajectory",
  "bugs": {
    "url": "https://github.com/Demogorgon314/HarnessTrajectory/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts --no-open",
    "build": "tsdown",
    "start": "node dist/main.js",
    "prepack": "node ../../scripts/prepack-cli.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --project server"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@harness-trajectory/core": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
